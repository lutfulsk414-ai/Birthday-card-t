<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Happy Birthday 🎂</title>
<style>
  :root{
    --bg:#07030d;
    --ink:#3d3446;
    --paper:#fffaf1;
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{
    margin:0;height:100%;background:var(--bg);overflow:hidden;color:#fff;
    font-family:"Trebuchet MS",system-ui,-apple-system,"Segoe UI",sans-serif;
  }
  canvas{position:fixed;inset:0;width:100%;height:100%;display:block}
  #sky{z-index:0}
  #rain{z-index:1;opacity:0;transition:opacity 1.2s ease}
  #rain.on{opacity:1}
  #fx{z-index:2;pointer-events:none}

  /* ================= cats scene ================= */
  #cats{
    position:fixed;inset:0;z-index:3;display:grid;place-items:center;pointer-events:none;
    opacity:0;transform:scale(.6);
    transition:opacity .6s ease, transform .9s cubic-bezier(.34,1.56,.64,1);
  }
  #cats.show{opacity:1;transform:scale(1)}
  #cats svg{
    width:min(90vw,95vh,560px);height:auto;overflow:visible;
    filter:drop-shadow(0 10px 34px rgba(255,105,180,.35));
  }
  #cats .flame{transform-box:fill-box;transform-origin:50% 100%;animation:flick .25s ease-in-out infinite alternate}
  @keyframes flick{from{transform:scale(1,1) rotate(-3deg)}to{transform:scale(.88,1.14) rotate(3deg)}}

  /* default (not animating) state */
  #cats .faceB,#cats .frost,#cats .rLaugh,#cats .sticker,#cats .cr{opacity:0}
  #cats .lhead,#cats .rcat,#cats .cake,#cats .sticker,#cats .cr{transform-box:fill-box}
  #cats .lhead{transform-origin:50% 100%}
  #cats .rcat{transform-origin:50% 100%}
  #cats .cake{transform-origin:50% 100%}
  #cats .sticker{transform-origin:50% 50%}

  /* one 6s cycle: idle -> plunge face into cake -> laugh + sticker -> rise with frosting */
  #cats.show .lhead{animation:dive 6s ease-in-out infinite}
  #cats.show .faceA{animation:faceA 6s steps(1,end) infinite}
  #cats.show .faceB{animation:faceB 6s steps(1,end) infinite}
  #cats.show .frost{animation:frost 6s ease-in-out infinite}
  #cats.show .cake{animation:squish 6s ease-in-out infinite}
  #cats.show .rcat{animation:shake 6s ease-in-out infinite}
  #cats.show .rIdle{animation:faceA 6s steps(1,end) infinite}
  #cats.show .rLaugh{animation:faceB 6s steps(1,end) infinite}
  #cats.show .sticker{animation:sticker 6s ease-in-out infinite}
  #cats.show .cr{animation:crumb 6s ease-out infinite}

  @keyframes dive{
    0%{transform:translateY(0) rotate(0)}
    10%{transform:translateY(-3px) rotate(-1.5deg)}
    20%{transform:translateY(0) rotate(0)}
    30%{transform:translateY(-3px) rotate(1.5deg)}
    42%{transform:translateY(-8px) rotate(-3deg)}
    50%{transform:translateY(32px) rotate(3deg)}
    72%{transform:translateY(32px) rotate(2deg)}
    84%{transform:translateY(0) rotate(0)}
    100%{transform:translateY(0) rotate(0)}
  }
  @keyframes faceA{0%{opacity:1}50%{opacity:0}73%{opacity:1}100%{opacity:1}}
  @keyframes faceB{0%{opacity:0}50%{opacity:1}73%{opacity:0}100%{opacity:0}}
  @keyframes frost{0%,73%{opacity:0}77%,90%{opacity:1}100%{opacity:0}}
  @keyframes squish{0%,49%{transform:scale(1,1)}52%,72%{transform:scale(1.06,.9)}82%,100%{transform:scale(1,1)}}
  @keyframes shake{
    0%,49%{transform:rotate(0)}
    53%{transform:rotate(-3deg)}57%{transform:rotate(3deg)}
    61%{transform:rotate(-3deg)}65%{transform:rotate(3deg)}
    69%{transform:rotate(-2deg)}73%,100%{transform:rotate(0)}
  }
  @keyframes sticker{
    0%,50%{opacity:0;transform:scale(.3) rotate(-14deg)}
    56%{opacity:1;transform:scale(1.15) rotate(-6deg)}
    60%,88%{opacity:1;transform:scale(1) rotate(-6deg)}
    95%,100%{opacity:0;transform:scale(.9) rotate(-6deg)}
  }
  @keyframes crumb{
    0%,50%{opacity:0;transform:translate(0,0)}
    53%{opacity:1}
    74%,100%{opacity:0;transform:translate(var(--dx),var(--dy))}
  }
  .stk{
    font-family:"Arial Black","Trebuchet MS",sans-serif;font-weight:900;
    paint-order:stroke;stroke:#fff;stroke-width:5px;stroke-linejoin:round;
  }

  /* ================= card ================= */
  #cardStage{
    position:fixed;inset:0;z-index:4;opacity:0;pointer-events:none;transition:opacity .7s ease;
  }
  #cardStage.show{opacity:1;pointer-events:auto}
  .pop{
    position:absolute;inset:0;display:grid;place-items:center;perspective:1800px;
    transform:scale(.4);transition:transform .9s cubic-bezier(.34,1.56,.64,1);
  }
  #cardStage.show .pop{transform:scale(1)}
  .book{
    --w:min(44vw,40vh,340px);
    --h:calc(var(--w) * 1.3);
    width:var(--w);height:var(--h);position:relative;cursor:pointer;
    transform-style:preserve-3d;
    transform:translateX(0) scale(1.6);
    transition:transform 1.4s cubic-bezier(.2,.8,.2,1);
    color:var(--ink);
  }
  .book.open{transform:translateX(calc(var(--w) / 2)) scale(1);cursor:default}
  .page,.face{
    position:absolute;inset:0;background:var(--paper);
    box-shadow:0 12px 44px rgba(255,105,180,.4);
  }
  .page.right{
    transform:translateZ(-1px);border-radius:3px 10px 10px 3px;
    background:linear-gradient(90deg,rgba(61,52,70,.16),rgba(61,52,70,0) 10%),var(--paper);
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    padding:calc(var(--w) * .06);text-align:center;
  }
  .cover{
    position:absolute;inset:0;transform-origin:left center;transform-style:preserve-3d;
    transition:transform 1.4s cubic-bezier(.4,.1,.2,1);
  }
  .book.open .cover{transform:rotateY(-180deg)}
  .face{backface-visibility:hidden;-webkit-backface-visibility:hidden;overflow:hidden}
  .face.front{
    border-radius:3px 10px 10px 3px;
    display:flex;flex-direction:column;align-items:center;justify-content:center;gap:calc(var(--w) * .04);
  }
  .face.back{
    transform:rotateY(180deg);border-radius:10px 3px 3px 10px;
    background:linear-gradient(270deg,rgba(61,52,70,.16),rgba(61,52,70,0) 10%),var(--paper);
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    padding:calc(var(--w) * .06);text-align:center;
  }
  .paw{width:74%;height:auto}
  .hand{font-family:"Bradley Hand","Segoe Print","Marker Felt","Comic Sans MS",cursive}
  .hint{font-size:calc(var(--w) * .075);opacity:.6;animation:pulse 1.8s ease-in-out infinite}
  @keyframes pulse{0%,100%{opacity:.25}50%{opacity:.75}}
  .doodle{width:84%;height:auto}
  .cap{font-size:calc(var(--w) * .085);margin-top:calc(var(--w) * .03)}
  .hb{font-size:calc(var(--w) * .12);line-height:1.05;margin:calc(var(--w) * .02) 0 0}
  .nm{font-size:calc(var(--w) * .13);line-height:1.1;color:#e2508f;margin:0}
  .cn{font-size:calc(var(--w) * .09);opacity:.75;margin:calc(var(--w) * .02) 0 0}
  .nm:empty,.cn:empty{display:none}

  /* message bar with heart (top of the card view) */
  #pill{
    position:absolute;left:50%;top:clamp(52px,9vh,120px);
    width:min(86vw,460px);min-height:42px;
    padding:11px 46px 11px 18px;border-radius:24px;
    background:linear-gradient(180deg,#fff,#ffe9f4);color:#8a6a86;
    font-size:14px;line-height:1.3;text-align:left;
    box-shadow:0 8px 30px rgba(255,105,180,.35);
    transform:translate(-50%,-14px) scale(.96);opacity:0;pointer-events:none;
    transition:opacity .5s ease, transform .5s ease;
  }
  #pill.show{opacity:1;transform:translate(-50%,0) scale(1)}
  #pill .ht{position:absolute;right:16px;top:50%;transform:translateY(-50%);color:#ff5fa2;font-size:18px;animation:beat 1.2s ease-in-out infinite}
  @keyframes beat{0%,100%{transform:translateY(-50%) scale(1)}50%{transform:translateY(-50%) scale(1.2)}}
  #pillText:empty::before{content:"\00a0"}

  /* ================= UI ================= */
  #snd,#replay{
    position:fixed;z-index:10;border:0;color:#fff;cursor:pointer;
    background:rgba(255,255,255,.12);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);
    border-radius:999px;font:inherit;
  }
  #snd{top:max(12px,env(safe-area-inset-top));right:12px;width:42px;height:42px;font-size:18px;display:none}
  #replay{
    bottom:max(16px,env(safe-area-inset-bottom));left:50%;transform:translate(-50%,20px);
    padding:10px 18px;font-size:15px;opacity:0;pointer-events:none;
    transition:opacity .6s ease, transform .6s ease;
  }
  #replay.show{opacity:1;pointer-events:auto;transform:translate(-50%,0)}
  #snd:focus-visible,#replay:focus-visible,#go:focus-visible,.book:focus-visible{outline:3px solid #fff;outline-offset:3px}

  #gate{
    position:fixed;inset:0;z-index:20;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;
    background:radial-gradient(circle at 50% 45%,#2a1145 0%,#07030d 70%);
    transition:opacity .6s ease;text-align:center;padding:24px;
  }
  #gate.hide{opacity:0;pointer-events:none}
  #gate .gift{font-size:72px;animation:giftbob 1.6s ease-in-out infinite;filter:drop-shadow(0 0 24px rgba(255,105,180,.6))}
  @keyframes giftbob{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-6px) rotate(-3deg)}}
  #gate p{margin:0;font-size:18px;opacity:.85}
  #go{
    border:0;cursor:pointer;font:inherit;font-size:17px;font-weight:700;color:#3d1230;
    padding:14px 30px;border-radius:999px;background:linear-gradient(135deg,#ffc2dd,#ff7ab8);
    box-shadow:0 8px 30px rgba(255,105,180,.45);
  }

  @media (max-height:520px){
    .pop{padding-top:48px}
    #pill{font-size:13px;padding:9px 44px 9px 16px}
  }

  @media (prefers-reduced-motion:reduce){
    #cats .flame,.hint,#gate .gift,#pill .ht{animation:none}
  }
</style>
</head>
<body>

<canvas id="sky"></canvas>
<canvas id="rain"></canvas>
<canvas id="fx"></canvas>

<!-- two cats + cake -->
<div id="cats" aria-hidden="true">
  <svg viewBox="0 0 320 250" xmlns="http://www.w3.org/2000/svg" stroke-linecap="round" stroke-linejoin="round">
    <g stroke="#3d3446" stroke-width="3">

      <!-- ground panel -->
      <path d="M12 200 L308 196 L310 236 L10 238 Z" fill="#fdeeb8"/>

      <!-- RIGHT CAT (blue-lavender, party hat, laughs when the other cat dives in) -->
      <g class="rcat">
        <path d="M270 192 q34 4 32 -32" fill="none" stroke-width="11"/>
        <path d="M270 192 q34 4 32 -32" fill="none" stroke="#e4e8ff" stroke-width="5"/>
        <ellipse cx="226" cy="172" rx="46" ry="32" fill="#e4e8ff"/>
        <path d="M170 96 L172 60 L202 80 Z" fill="#e4e8ff"/>
        <path d="M258 96 L256 60 L226 80 Z" fill="#e4e8ff"/>
        <ellipse cx="214" cy="114" rx="46" ry="38" fill="#e4e8ff"/>
        <g transform="rotate(8 214 78)">
          <path d="M214 32 L192 78 L236 78 Z" fill="#7fb2ff"/>
          <path d="M204 56 l20 4 M198 68 l32 4" stroke="#fff" stroke-width="3" fill="none"/>
          <circle cx="214" cy="32" r="5" fill="#fff"/>
        </g>
        <circle cx="188" cy="124" r="6" fill="#ff9fc6" stroke="none" opacity=".7"/>
        <circle cx="240" cy="124" r="6" fill="#ff9fc6" stroke="none" opacity=".7"/>
        <ellipse cx="214" cy="118" rx="3" ry="2" fill="#ff7ab8" stroke="none"/>
        <!-- smug -->
        <g class="rIdle">
          <path d="M192 112 h16 M220 112 h16" fill="none"/>
          <circle cx="204" cy="117" r="3.5" fill="#3d3446" stroke="none"/>
          <circle cx="232" cy="117" r="3.5" fill="#3d3446" stroke="none"/>
          <path d="M204 126 q10 14 20 0 z" fill="#ff6f91" stroke-width="2.5"/>
        </g>
        <!-- laughing >  < -->
        <g class="rLaugh">
          <path d="M194 106 l12 6 l-12 6" fill="none"/>
          <path d="M234 106 l-12 6 l12 6" fill="none"/>
          <path d="M198 124 Q214 152 230 124 Z" fill="#ff6f91" stroke-width="2.5"/>
          <path d="M208 140 q6 -7 12 0" fill="#ff9fc6" stroke="none"/>
        </g>
      </g>

      <!-- LEFT CAT body -->
      <ellipse cx="100" cy="164" rx="46" ry="34" fill="#fff"/>

      <!-- CAKE -->
      <g class="cake">
        <path d="M54 166 h92 v26 q0 8 -8 8 h-76 q-8 0 -8 -8 Z" fill="#ff9ccb"/>
        <ellipse cx="100" cy="166" rx="46" ry="10" fill="#ffc2dd"/>
        <path d="M58 168 q4 16 9 0 M78 172 q4 14 8 0 M114 172 q4 14 8 0 M133 168 q4 16 9 0" fill="none" stroke="#ff7ab8" stroke-width="3"/>
        <rect x="97" y="146" width="6" height="20" rx="2" fill="#fff6d6" stroke-width="2.5"/>
        <path class="flame" d="M100 130 q-7 9 0 15 q7 -6 0 -15z" fill="#ffc94d" stroke-width="2"/>
      </g>
      <!-- paws hugging the cake -->
      <ellipse cx="54" cy="184" rx="11" ry="9" fill="#fff"/>
      <ellipse cx="146" cy="184" rx="11" ry="9" fill="#fff"/>

      <!-- LEFT CAT head (this is the one that dives into the cake) -->
      <g class="lhead">
        <path d="M54 70 L52 30 L88 52 Z" fill="#fff"/>
        <path d="M146 70 L148 30 L112 52 Z" fill="#fff"/>
        <path d="M60 60 L60 42 L76 52 Z" fill="#ffc2dd" stroke="none"/>
        <path d="M140 60 L140 42 L124 52 Z" fill="#ffc2dd" stroke="none"/>
        <ellipse cx="100" cy="88" rx="52" ry="40" fill="#fff"/>
        <path d="M50 90 l-24 -5 M50 98 l-26 4 M52 106 l-22 10 M150 90 l24 -5 M150 98 l26 4 M148 106 l22 10" fill="none" stroke-width="2"/>
        <circle cx="62" cy="100" r="6" fill="#ff9fc6" stroke="none" opacity=".7"/>
        <circle cx="138" cy="100" r="6" fill="#ff9fc6" stroke="none" opacity=".7"/>

        <!-- excited face -->
        <g class="faceA">
          <circle cx="76" cy="82" r="9" fill="#fff"/>
          <circle cx="124" cy="82" r="9" fill="#fff"/>
          <circle cx="77" cy="83" r="5.5" fill="#3d3446" stroke="none"/>
          <circle cx="123" cy="83" r="5.5" fill="#3d3446" stroke="none"/>
          <circle cx="79" cy="80.5" r="2" fill="#fff" stroke="none"/>
          <circle cx="125" cy="80.5" r="2" fill="#fff" stroke="none"/>
          <ellipse cx="100" cy="96" rx="4" ry="3" fill="#ff7ab8" stroke="none"/>
          <path d="M80 102 Q100 130 120 102 Z" fill="#ff6f91" stroke-width="2.5"/>
          <path d="M84 103 l4 8 l4 -8 Z" fill="#fff" stroke-width="2"/>
          <path d="M108 103 l4 8 l4 -8 Z" fill="#fff" stroke-width="2"/>
        </g>

        <!-- face stuffed in cake -->
        <g class="faceB">
          <path d="M64 80 q12 10 24 0 M112 80 q12 10 24 0" fill="none"/>
          <ellipse cx="100" cy="96" rx="4" ry="3" fill="#ff7ab8" stroke="none"/>
          <path d="M50 96 Q72 88 100 98 Q128 88 150 96 Q154 124 128 130 Q100 138 72 130 Q46 124 50 96 Z" fill="#ff9ccb" stroke-width="2.5"/>
          <g fill="#fff" stroke="none"><circle cx="70" cy="110" r="3"/><circle cx="96" cy="118" r="3.5"/><circle cx="124" cy="108" r="3"/><circle cx="134" cy="120" r="2.5"/></g>
        </g>

        <!-- frosting smudges left on the face after coming up -->
        <g class="frost" fill="#ff9ccb" stroke="none">
          <circle cx="100" cy="96" r="5.5"/>
          <ellipse cx="66" cy="102" rx="8" ry="6"/>
          <ellipse cx="134" cy="98" rx="7" ry="5"/>
          <circle cx="98" cy="58" r="6"/>
          <circle cx="112" cy="120" r="4"/>
        </g>
      </g>

      <!-- flying crumbs -->
      <g stroke="none">
        <circle class="cr" style="--dx:-46px;--dy:-38px" cx="70" cy="160" r="4" fill="#ff9ccb"/>
        <circle class="cr" style="--dx:-24px;--dy:-58px" cx="84" cy="158" r="3" fill="#fff"/>
        <circle class="cr" style="--dx:8px;--dy:-64px" cx="102" cy="158" r="4" fill="#ffc2dd"/>
        <circle class="cr" style="--dx:34px;--dy:-52px" cx="118" cy="158" r="3" fill="#ff7ab8"/>
        <circle class="cr" style="--dx:52px;--dy:-34px" cx="132" cy="160" r="4" fill="#fff"/>
        <circle class="cr" style="--dx:-58px;--dy:-14px" cx="60" cy="164" r="3" fill="#ffc2dd"/>
      </g>

      <!-- HAPPY BIRTHDAY sticker -->
      <g class="sticker" stroke="none">
        <text class="stk" x="76" y="30" font-size="24" text-anchor="middle"><tspan fill="#ff5fa2">H</tspan><tspan fill="#b38cff">A</tspan><tspan fill="#ff5fa2">P</tspan><tspan fill="#b38cff">P</tspan><tspan fill="#ff5fa2">Y</tspan></text>
        <text class="stk" x="76" y="54" font-size="22" text-anchor="middle"><tspan fill="#ff5fa2">B</tspan><tspan fill="#ffa94d">I</tspan><tspan fill="#5ec8ff">R</tspan><tspan fill="#a78bfa">T</tspan><tspan fill="#ff5fa2">H</tspan><tspan fill="#ffa94d">D</tspan><tspan fill="#5ec8ff">A</tspan><tspan fill="#a78bfa">Y</tspan></text>
