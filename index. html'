        <path d="M12 44 v8 M8 48 h8" stroke="#5ec8ff" stroke-width="3" fill="none"/>
      </g>
    </g>
  </svg>
</div>

<!-- birthday card -->
<div id="cardStage">
  <div id="pill" aria-live="polite"><span id="pillText"></span><span class="ht">♥</span></div>
  <div class="pop">
    <div class="book" id="book" role="button" tabindex="0" aria-label="Open the birthday card">
      <div class="page right">
        <svg class="doodle" viewBox="0 0 130 110" fill="none" stroke="#3d3446" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
          <!-- three-tier cake -->
          <path d="M8 100 h72"/>
          <rect x="14" y="76" width="60" height="24" rx="5" fill="#ffe0ee"/>
          <rect x="22" y="56" width="44" height="22" rx="5" fill="#fff"/>
          <rect x="30" y="40" width="28" height="18" rx="5" fill="#ffe0ee"/>
          <path d="M14 86 q5 7 10 0 q5 7 10 0 q5 7 10 0 q5 7 10 0 q5 7 10 0 q5 7 10 0" stroke="#ff7ab8"/>
          <path d="M22 65 q5 7 11 0 q5 7 11 0 q5 7 11 0" stroke="#ff7ab8"/>
          <rect x="42" y="27" width="4" height="13" rx="1.5" fill="#ffe6a8"/>
          <path class="flame" d="M44 14 q-5 7 0 12 q5 -5 0 -12z" fill="#ffb703" stroke-width="2"/>
          <!-- squinting doodle face + sparkles -->
          <path d="M92 30 l9 4 l-9 4 M120 30 l-9 4 l9 4"/>
          <path d="M100 46 q6 7 12 0"/>
          <path d="M96 10 v9 M91.5 14.5 h9 M118 6 v7 M114.5 9.5 h7" stroke="#ff7ab8"/>
        </svg>
        <p class="hand hb">Happy Birthday</p>
        <p class="hand nm" id="nm"></p>
        <p class="hand cn" id="cn"></p>
      </div>

      <div class="cover">
        <div class="face front">
          <svg class="paw" viewBox="0 0 100 130" stroke-linecap="round" stroke-linejoin="round">
            <defs>
              <g id="pawShape">
                <ellipse cx="20" cy="52" rx="10" ry="17" transform="rotate(-18 20 52)"/>
                <ellipse cx="39" cy="34" rx="10" ry="20" transform="rotate(-6 39 34)"/>
                <ellipse cx="61" cy="34" rx="10" ry="20" transform="rotate(6 61 34)"/>
                <ellipse cx="80" cy="52" rx="10" ry="17" transform="rotate(18 80 52)"/>
                <path d="M22 66 C16 92 22 124 50 124 C78 124 84 92 78 66 C72 52 28 52 22 66 Z"/>
              </g>
            </defs>
            <use href="#pawShape" fill="#fff" stroke="#3d3446" stroke-width="4.5"/>
            <use href="#pawShape" fill="#fff" stroke="none"/>
          </svg>
          <div class="hand hint">touch me</div>
        </div>
        <div class="face back">
          <svg class="doodle" viewBox="0 0 120 130" fill="none" stroke="#3d3446" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
            <g transform="rotate(-10 60 50)">
              <path d="M60 10 L42 50 L78 50 Z" fill="#ffd166"/>
              <path d="M52 28 l16 3 M47 40 l26 3" stroke="#fff"/>
              <circle cx="60" cy="10" r="4.5" fill="#ff7ab8"/>
            </g>
            <circle cx="60" cy="92" r="38" fill="#fff" stroke-dasharray="1 0"/>
            <path d="M42 86 v6 M78 86 v6" stroke-width="3.2"/>
            <path d="M50 102 q10 9 20 0"/>
            <ellipse cx="38" cy="100" rx="6" ry="4" fill="#ff9fc6" stroke="none" opacity=".75"/>
            <ellipse cx="82" cy="100" rx="6" ry="4" fill="#ff9fc6" stroke="none" opacity=".75"/>
            <path d="M8 60 q4 -6 8 0 q4 6 8 0" stroke="#ff7ab8"/>
            <path d="M98 30 v9 M93.5 34.5 h9" stroke="#ff7ab8"/>
            <path d="M14 112 h4 M20 116 h4" stroke="#3d3446"/>
          </svg>
          <div class="hand cap">make a wish</div>
        </div>
      </div>
    </div>
  </div>
</div>

<button id="snd" aria-label="Toggle sound">🔊</button>
<button id="replay">↺ Play again</button>

<div id="gate">
  <div class="gift">🎁</div>
  <p>Something special is waiting for you</p>
  <button id="go">Open it</button>
</div>

<script>
(() => {
  /* ===== EDIT THESE ===== */
  const CONFIG = {
    name: "YOU",                       // last word: HAPPY BIRTHDAY TO <name>
    message: "Happy Birthday! May your day be full of love, laughter and cake. You deserve all the happiness in the world.",   // typed in the bar above the card
    cardText: "Have the best day ever!"   // small line on the card page. Use "" to hide.
  };
  /* ====================== */

  const $ = s => document.querySelector(s);
  const sleep = ms => new Promise(r => setTimeout(r, ms));
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  const NAME = (CONFIG.name || "YOU").trim() || "YOU";

  $('#nm').textContent = NAME.toUpperCase() === "YOU" ? "" : NAME + "!";
  $('#cn').textContent = CONFIG.cardText || "";

  const sky = $('#sky'), rain = $('#rain'), fx = $('#fx');
  const sctx = sky.getContext('2d'), rctx = rain.getContext('2d'), fctx = fx.getContext('2d');
  let W = 0, H = 0;

  /* ---------- matrix rain ---------- */
  const GLYPHS = '01ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉ';
  let fs = 15, drops = [], active = [], lastRain = 0, rainActive = false;

  function initRain() {
    fs = Math.round(15 * dpr);
    const cols = Math.ceil(W / fs);
    drops = Array.from({ length: cols }, () => Math.random() * -40);
    active = Array.from({ length: cols }, () => Math.random() < 0.7);
    rctx.fillStyle = '#07030d';
    rctx.fillRect(0, 0, W, H);
  }
  function drawRain(t) {
    if (t - lastRain < 45) return;
    lastRain = t;
    rctx.fillStyle = 'rgba(7,3,13,.12)';
    rctx.fillRect(0, 0, W, H);
    rctx.font = fs + 'px monospace';
    for (let i = 0; i < drops.length; i++) {
      if (!active[i]) continue;
      const y = drops[i] * fs;
      rctx.fillStyle = Math.random() < 0.12 ? '#ffe3f1' : '#ff8fc7';
      rctx.fillText(GLYPHS[(Math.random() * GLYPHS.length) | 0], i * fs, y);
      if (y > H && Math.random() > 0.975) drops[i] = 0;
      drops[i] += 1;
    }
  }

  /* ---------- starry sky + hearts + confetti ---------- */
  let stars = [], bits = [], skyOn = false, lastHeart = 0;
  const CONF = ['#ff7ab8', '#ffc2dd', '#ffd166', '#b9a3ff', '#ffffff'];

  function initStars() {
    const n = Math.round((W * H) / (9000 * dpr * dpr));
    stars = Array.from({ length: n }, () => ({
      x: Math.random() * W, y: Math.random() * H,
      r: (Math.random() * 1.4 + 0.4) * dpr,
      ph: Math.random() * 6.28, sp: 0.5 + Math.random() * 1.5,
      pink: Math.random() < 0.35
    }));
  }
  function drawSky(t) {
    const g = sctx.createRadialGradient(W / 2, H * .55, 0, W / 2, H * .55, Math.max(W, H) * .75);
    g.addColorStop(0, '#2a1145'); g.addColorStop(1, '#07030d');
    sctx.globalAlpha = 1;
    sctx.fillStyle = g; sctx.fillRect(0, 0, W, H);

    for (const s of stars) {
      sctx.globalAlpha = .25 + .75 * Math.abs(Math.sin(t / 1000 * s.sp + s.ph));
      sctx.fillStyle = s.pink ? '#ff9ccb' : '#fff';
      sctx.beginPath(); sctx.arc(s.x, s.y, s.r, 0, 6.283); sctx.fill();
      s.y -= .06 * dpr * s.sp;
      if (s.y < -4) { s.y = H + 4; s.x = Math.random() * W; }
    }

    if (skyOn && t - lastHeart > 500) {
      lastHeart = t;
      bits.push({
        kind: 'heart', x: Math.random() * W, y: H + 20 * dpr,
        vx: 0, vy: -(0.6 + Math.random() * 1.1) * dpr,
        s: (10 + Math.random() * 16) * dpr, a: .85, fade: .0015,
        ph: Math.random() * 6, c: '#ff7ab8'
      });
    }

    for (let i = bits.length - 1; i >= 0; i--) {
      const b = bits[i];
      b.x += b.vx; b.y += b.vy;
      if (b.g) { b.vy += b.g; b.vx *= .99; b.rot += b.vr; }
      else b.x += Math.sin(t / 600 + b.ph) * .3 * dpr;
      b.a -= b.fade;
      if (b.a <= 0 || b.y < -40 * dpr || b.y > H + 60 * dpr) { bits.splice(i, 1); continue; }
      sctx.globalAlpha = Math.min(1, b.a);
      sctx.fillStyle = b.c;
      if (b.kind === 'heart') {
        sctx.font = b.s + 'px serif';
        sctx.textAlign = 'center';
        sctx.fillText('♥', b.x, b.y);
      } else {
        sctx.save();
        sctx.translate(b.x, b.y); sctx.rotate(b.rot);
        sctx.fillRect(-b.s / 2, -b.s / 4, b.s, b.s / 2);
        sctx.restore();
      }
    }
    sctx.globalAlpha = 1;
  }
  function burst() {
    for (let i = 0; i < 90; i++) {
      const ang = Math.random() * 6.283, sp = (3 + Math.random() * 9) * dpr;
      const heart = Math.random() < .4;
      bits.push({
        kind: heart ? 'heart' : 'conf', x: W / 2, y: H / 2,
        vx: Math.cos(ang) * sp, vy: Math.sin(ang) * sp - 3 * dpr, g: .18 * dpr,
        s: (heart ? 12 + Math.random() * 14 : 6 + Math.random() * 6) * dpr,
        a: 1, fade: .006, rot: Math.random() * 6, vr: (Math.random() - .5) * .3,
        c: CONF[(Math.random() * CONF.length) | 0], ph: 0
      });
    }
  }

  /* ---------- particle words ---------- */
  let batches = [];
  const PCOL = ['#ffb3d9', '#ff8fc7', '#ffd6ec', '#ffffff', '#ff8fc7'];
  const DCOL = ['#ffc2dd', '#ff8fc7', '#ffd6ec', '#ff7ab8', '#ffe3f1'];

  function word(text, hold, dots) {
    return new Promise(res => {
      const off = document.createElement('canvas');
      off.width = W; off.height = H;
      const c = off.getContext('2d');
      const face = '"Arial Black","Helvetica Neue",Arial,sans-serif';
      let size = 100;
      c.font = `900 ${size}px ${face}`;
      const tw = c.measureText(text).width || 1;
      size = Math.min(size * (W * .86) / tw, H * (text.length <= 2 ? .4 : .26));
      c.font = `900 ${size}px ${face}`;
      c.textAlign = 'center'; c.textBaseline = 'middle';
      c.fillStyle = '#fff';
      c.fillText(text, W / 2, H / 2);

      const data = c.getImageData(0, 0, W, H).data;
      const step = dots ? Math.max(3.5 * dpr, Math.round(size / 34)) : Math.max(4 * dpr, Math.round(size / 28));
      const pal = dots ? DCOL : PCOL;
      const ps = [];
      for (let y = 0; y < H; y += step) {
        for (let x = 0; x < W; x += step) {
          if (data[(y * W + x) * 4 + 3] > 128) {
            ps.push({
              x: Math.random() * W, y: Math.random() * H, tx: x, ty: y,
              k: .07 + Math.random() * .06, a: 0,
              s: step * (dots ? .9 + Math.random() * .5 : .55 + Math.random() * .3),
              c: pal[(Math.random() * pal.length) | 0], vx: 0, vy: 0
            });
          }
        }
      }
      const batch = { ps, mode: 'form', dots: !!dots };
      batches.push(batch);
      setTimeout(() => {
        batch.mode = 'dissolve';
        for (const p of batch.ps) {
          p.vx = (Math.random() - .5) * 6 * dpr;
          p.vy = -(Math.random() * 4 + 1) * dpr;
        }
        setTimeout(res, 150);
      }, 700 + hold);
    });
  }
  function drawWords() {
    fctx.clearRect(0, 0, W, H);
    for (const b of batches) {
      for (const p of b.ps) {
        if (b.mode === 'form') {
          p.x += (p.tx - p.x) * p.k; p.y += (p.ty - p.y) * p.k;
          p.a = Math.min(1, p.a + .06);
        } else {
          p.x += p.vx; p.y += p.vy; p.a -= .03;
        }
        if (p.a <= 0) continue;
        fctx.globalAlpha = p.a;
        fctx.fillStyle = p.c;
        if (b.dots) {
          fctx.beginPath(); fctx.arc(p.x, p.y, p.s * .6, 0, 6.283); fctx.fill();
        } else {
          fctx.fillRect(p.x - p.s / 2, p.y - p.s / 2, p.s, p.s);
        }
      }
    }
    fctx.globalAlpha = 1;
    batches = batches.filter(b => b.mode === 'form' || b.ps.some(p => p.a > 0));
  }

  /* ---------- audio (synth Happy Birthday + sound effects) ---------- */
  let ac = null, master = null, mus = null, muted = false;
  const N = { G4: 392, A4: 440, B4: 493.88, C5: 523.25, D5: 587.33, E5: 659.25, F5: 698.46, G5: 783.99 };
  const MELODY = [
    [N.G4,.75],[N.G4,.25],[N.A4,1],[N.G4,1],[N.C5,1],[N.B4,2],
    [N.G4,.75],[N.G4,.25],[N.A4,1],[N.G4,1],[N.D5,1],[N.C5,2],
    [N.G4,.75],[N.G4,.25],[N.G5,1],[N.E5,1],[N.C5,1],[N.B4,1],[N.A4,1],
    [N.F5,.75],[N.F5,.25],[N.E5,1],[N.C5,1],[N.D5,1],[N.C5,2]
  ];
  function initAudio() {
    if (ac) return;
    const AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) return;
    ac = new AC();
    master = ac.createGain();
    master.gain.value = muted ? 0 : .5;
    master.connect(ac.destination);
  }
  function tone(f, t, d, type, v, dest) {
    const o = ac.createOscillator(), g = ac.createGain();
    o.type = type; o.frequency.value = f;
    g.gain.setValueAtTime(0, t);
    g.gain.linearRampToValueAtTime(v, t + .01);
    g.gain.exponentialRampToValueAtTime(.0001, t + d);
    o.connect(g); g.connect(dest);
    o.start(t); o.stop(t + d + .05);
  }
  function blip(f) { if (ac) tone(f, ac.currentTime, .18, 'sine', .15, master); }
  function splat() {           // the "face in the cake" sound
    if (!ac) return;
    const t = ac.currentTime, len = Math.floor(ac.sampleRate * .18);
    const buf = ac.createBuffer(1, len, ac.sampleRate), d = buf.getChannelData(0);
    for (let i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / len);
    const src = ac.createBufferSource(); src.buffer = buf;
    const f = ac.createBiquadFilter(); f.type = 'lowpass'; f.frequency.value = 900;
    const g = ac.createGain(); g.gain.value = .6;
    src.connect(f); f.connect(g); g.connect(master); src.start(t);
    tone(180, t, .16, 'sine', .3, master);
  }
  function stopMusic() { if (mus) { try { mus.disconnect(); } catch (e) {} mus = null; } }
  function playBirthday() {
    if (!ac) return;
    stopMusic();
    mus = ac.createGain(); mus.connect(master);
    const beat = .46; let t = ac.currentTime + .1;
    for (const [f, b] of MELODY) {
      tone(f, t, b * beat * 1.6, 'triangle', .22, mus);
      tone(f * 2, t, b * beat, 'sine', .06, mus);
      t += b * beat;
    }
  }
  $('#snd').addEventListener('click', () => {
    muted = !muted;
    if (master) master.gain.value = muted ? 0 : .5;
    $('#snd').textContent = muted ? '🔇' : '🔊';
  });

  /* ---------- sequence ---------- */
  let runId = 0;
  const cats = $('#cats'), stage = $('#cardStage'), book = $('#book'), replay = $('#replay');
  const pill = $('#pill'), pillText = $('#pillText');

  function resetScene() {
    stopMusic();
    batches = []; bits = []; skyOn = false;
    cats.classList.remove('show');
    stage.classList.remove('show');
    book.classList.remove('open');
    replay.classList.remove('show');
    pill.classList.remove('show');
    pillText.textContent = '';
    rain.classList.remove('on');
    rctx.fillStyle = '#07030d'; rctx.fillRect(0, 0, W, H);
  }

  async function run() {
    const id = ++runId;
    const alive = () => id === runId;
    resetScene();
    rainActive = true;
    rain.classList.add('on');
    await sleep(1600); if (!alive()) return;

    // 3 .. 2 .. 1
    for (const n of ['3', '2', '1']) {
      blip(n === '1' ? 1320 : 880);
      await word(n, 450); if (!alive()) return;
    }
    // HAPPY / BIRTHDAY / TO / YOU  (last word is made of soft round dots)
    const words = ['HAPPY', 'BIRTHDAY', 'TO', NAME.toUpperCase()];
    for (let i = 0; i < words.length; i++) {
      blip(1046);
      await word(words[i], i === words.length - 1 ? 1100 : 800, i === words.length - 1); if (!alive()) return;
    }

    rain.classList.remove('on');
    skyOn = true;
    setTimeout(() => { if (alive()) rainActive = false; }, 1400);
    await sleep(500); if (!alive()) return;

    // cats + cake (the dive happens ~3s after this starts)
    playBirthday();
    cats.classList.add('show');
    setTimeout(() => { if (alive()) splat(); }, 3050);
    await sleep(6600); if (!alive()) return;

    cats.classList.remove('show');
    await sleep(800); if (!alive()) return;
    stage.classList.add('show');
  }

  async function typeMessage(id) {
    pill.classList.add('show');
    pillText.textContent = '';
    for (const ch of CONFIG.message) {
      if (id !== runId) return;
      pillText.textContent += ch;
      await sleep(45);
    }
  }

  function openCard() {
    if (book.classList.contains('open')) return;
    const id = runId;
    book.classList.add('open');
    setTimeout(() => { if (id === runId) typeMessage(id); }, 900);
    setTimeout(() => { if (id === runId) burst(); }, 1000);
    setTimeout(() => { if (id === runId) replay.classList.add('show'); }, 2400);
  }
  book.addEventListener('click', openCard);
  book.addEventListener('keydown', e => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openCard(); }
  });
  replay.addEventListener('click', run);

  $('#go').addEventListener('click', () => {
    initAudio();
    if (ac && ac.state === 'suspended') ac.resume();
    $('#gate').classList.add('hide');
    $('#snd').style.display = 'block';
    run();
  });

  /* ---------- main loop ---------- */
  function resize() {
    W = Math.round(innerWidth * dpr); H = Math.round(innerHeight * dpr);
    for (const c of [sky, rain, fx]) { c.width = W; c.height = H; }
    initRain(); initStars();
  }
  window.addEventListener('resize', resize);
  resize();

  function frame(t) {
    drawSky(t);
    if (rainActive) drawRain(t);
    drawWords();
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
})();
</script>
</body>
</html>
